# ---- PostgreSQL (docker-compose) ----
POSTGRES_USER=expence
POSTGRES_PASSWORD=expence
POSTGRES_DB=expence_tracker
POSTGRES_PORT=5432

# ---- API (NestJS + Prisma) ----
# Must match the POSTGRES_* values above.
DATABASE_URL="postgresql://expence:expence@localhost:5432/expence_tracker?schema=public"
PORT=4000

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
